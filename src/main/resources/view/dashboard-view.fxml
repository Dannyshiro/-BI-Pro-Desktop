<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ejemplo.bipro.controller.DashboardController"
            fitToWidth="true" styleClass="scroll-contenido">
    <VBox spacing="20.0">
        <padding><Insets top="24.0" right="28.0" bottom="32.0" left="28.0"/></padding>

        <HBox styleClass="hero">
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <Label text="RESUMEN DEL NEGOCIO" styleClass="hero-kicker"/>
                <Label fx:id="lblSaludo" styleClass="hero-titulo"/>
                <Label fx:id="lblResumen" styleClass="hero-texto" wrapText="true"/>
                <Label fx:id="lblPendientes" styleClass="hero-sub" wrapText="true"/>
            </VBox>
            <Button fx:id="btnNuevaVenta" text="Nueva venta" onAction="#onNuevaVenta" styleClass="hero-btn"/>
            <Button fx:id="btnOrden" text="Orden sugerida" onAction="#onOrdenSugerida" styleClass="hero-btn-sec"/>
        </HBox>

        <VBox styleClass="tarjeta">
            <HBox alignment="CENTER_LEFT">
                <Label text="Flujo del día" styleClass="h3"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblFlujo" styleClass="caption"/>
            </HBox>
            <HBox fx:id="boxFlujo" spacing="10.0"/>
        </VBox>

        <HBox fx:id="boxKpis" spacing="16.0"/>

        <HBox spacing="16.0">
            <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS">
                <Label text="Tendencia de ventas" styleClass="h3"/>
                <Label fx:id="lblTendencia" styleClass="caption"/>
                <LineChart fx:id="grafTendencia" createSymbols="false" animated="false" prefHeight="320.0">
                    <xAxis><CategoryAxis/></xAxis>
                    <yAxis><NumberAxis/></yAxis>
                </LineChart>
            </VBox>
            <VBox styleClass="tarjeta" prefWidth="420.0" minWidth="360.0">
                <Label text="Diagnóstico empresarial" styleClass="h3"/>
                <Label text="Generado con los datos actuales" styleClass="caption"/>
                <ListView fx:id="lstDiagnostico" styleClass="lista-plana" VBox.vgrow="ALWAYS" prefHeight="330.0"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
